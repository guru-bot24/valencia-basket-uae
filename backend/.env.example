# Copy this to .env.local for local dev, or set these as service variables in Railway.
# Never commit an actual .env file — it's gitignored.

# --- Database (required) ---
DATABASE_URL=

# --- Admin seed (required for first login) ---
ADMIN_SEED_PASSWORD=

# --- Email notifications (optional — skipped gracefully if unset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFICATION_EMAIL=

# --- Google Sheets sync (optional — fire-and-forget, skipped if unset) ---
# GOOGLE_SERVICE_ACCOUNT_JSON must be rotated before use — the key found in the
# old .replit file was exposed in plaintext and must not be reused as-is.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_ID=
